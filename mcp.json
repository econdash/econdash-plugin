{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "econdash": {
      "type": "streamable-http",
      "url": "https://mcp.econdash.org/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://mcp.econdash.org/oauth/authorize",
            "tokenUrl": "https://mcp.econdash.org/oauth/token",
            "registrationUrl": "https://mcp.econdash.org/oauth/register",
            "baseScopes": [
              "econdash.read"
            ]
          }
        }
      }
    }
  }
}
